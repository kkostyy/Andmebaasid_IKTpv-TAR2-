+
+            $('#paremale, #vasakule, #peida, #kuva, #toggle, #slaid, nav a[title], #pildiKast img')
+                .on('mouseenter', function (e) {
+                    // tekst võetakse title'ist, et brauseri enda vihjet ei tuleks
+                    var tekst = $(this).attr('title');
+                    $(this).data('vihje', tekst).removeAttr('title');
+                    $vihje.text(tekst).stop(true, true).fadeIn(300);
+                    liigutaVihje(e);
+                })
+                .on('mousemove', liigutaVihje)
+                .on('mouseleave', function () {
+                    $(this).attr('title', $(this).data('vihje'));
+                    $vihje.stop(true, true).fadeOut(200);
+                })
+                .on('mousedown', function () {
+                    // lohistamise ajal vihje kaob
+                    $vihje.stop(true, true).fadeOut(100);
+                });
+
+            // vihjemull on hiirest 15px paremal ja 20px all
+            function liigutaVihje(e) {
+                $vihje.css({ left: e.pageX + 15, top: e.pageY + 20 });
+            }
