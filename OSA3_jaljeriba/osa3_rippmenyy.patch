diff --git a/Kujundus1/rippmenyy.css b/Kujundus1/rippmenyy.css
new file mode 100644
index 0000000..ae5494c
--- /dev/null
+++ b/Kujundus1/rippmenyy.css
@@ -0,0 +1,57 @@
+/************ RIPPMENÜÜ "Tehtud tööd" peamenüüs *****************/
+/* et rippmenüü ei jääks peidetuks */
+nav > ul {
+    overflow: visible;
+}
+nav > ul > li {
+    position: relative;
+}
+/* nool "Tehtud tööd" lingi järel */
+nav > ul > li.ripp > a::after {
+    content: " \25BE";
+}
+
+/* alammenüü – peidus, jQuery näitab seda slideDown() abil */
+nav ul.alammenyy {
+    display: none;
+    position: absolute;
+    top: 100%;
+    left: 0;
+    z-index: 1000;
+    min-width: 300px;
+    flex-direction: column;
+    flex-wrap: nowrap;
+    background-color: green;
+    border: 2px solid darkgreen;
+    border-top: 5px solid darkgreen;
+    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.3);
+    text-align: left;
+}
+nav ul.alammenyy li {
+    float: none;
+    display: block;
+}
+nav ul.alammenyy li a {
+    border: none;
+    border-bottom: 1px solid darkgreen;
+    padding: 8px 14px;
+    text-align: left;
+    white-space: nowrap;
+}
+/* jQuery hover() lisab selle klassi */
+nav ul li a.hover {
+    background-color: darkgreen;
+    color: white;
+}
+
+/* Mobiilivaade: menüü kitsam ja pikad nimed murduvad */
+@media (max-width: 640px) {
+    nav ul.alammenyy {
+        min-width: 220px;
+        left: auto;
+        right: 0;
+    }
+    nav ul.alammenyy li a {
+        white-space: normal;
+    }
+}
diff --git a/Kujundus1/rippmenyy.js b/Kujundus1/rippmenyy.js
new file mode 100644
index 0000000..4a9ac6e
--- /dev/null
+++ b/Kujundus1/rippmenyy.js
@@ -0,0 +1,23 @@
+// Rippmenüü "Tehtud tööd" peamenüüs jQuery abil
+
+$(function () {
+    var $ripp = $('nav li.ripp');
+    var $alammenyy = $ripp.children('ul.alammenyy');
+
+    // alammenüü on alguses peidus
+    $alammenyy.hide();
+
+    // hiir "Tehtud tööd" peale -> menüü libiseb alla, hiir ära -> üles
+    $ripp.hover(function () {
+        $alammenyy.stop(true, true).slideDown(250);
+    }, function () {
+        $alammenyy.stop(true, true).slideUp(200);
+    });
+
+    // hover-efekt kõigil menüü linkidel
+    $('nav a').hover(function () {
+        $(this).addClass('hover');
+    }, function () {
+        $(this).removeClass('hover');
+    });
+});
