diff --git a/Kujundus1/rippmenyy.css b/Kujundus1/rippmenyy.css
new file mode 100644
index 0000000..3f4fdc6
--- /dev/null
+++ b/Kujundus1/rippmenyy.css
@@ -0,0 +1,37 @@
+/************ ALAMMENÜÜ "Tehtud tööd" (Metsheina hover-menüü näite järgi) *****************/
+/* "Tehtud tööd" plokk on 200px lai, alammenüü on alati avatud */
+nav ul li.ripp {
+    width: 200px;
+}
+nav ul li.ripp > a {
+    border-bottom: 1px solid #fff;
+}
+nav ul.alammenyy {
+    display: block;
+    list-style-type: none;
+    width: 180px;
+    margin: 0;
+    padding: 0 0 0 20px;     /* alammenüü on veidi taandega */
+    background: none;
+    overflow: visible;
+}
+nav ul.alammenyy li {
+    display: inline;
+    float: none;
+}
+nav ul.alammenyy li a {
+    display: block;
+    border: none;
+    border-bottom: 1px solid #fff;
+    text-decoration: none;
+    background: green;
+    color: #fff;
+    padding: 0.3em;
+    text-align: left;
+}
+/* jQuery hover() lisab selle klassi */
+nav a.hover,
+nav ul.alammenyy li a.hover {
+    background: #3C9;
+    font-weight: 700;
+}
diff --git a/Kujundus1/rippmenyy.js b/Kujundus1/rippmenyy.js
new file mode 100644
index 0000000..a1f105f
--- /dev/null
+++ b/Kujundus1/rippmenyy.js
@@ -0,0 +1,9 @@
+// "Tehtud tööd" alammenüü hover-efekt jQuery abil (Metsheina näite järgi)
+$(function () {
+    $('nav a').hover(function (event) {
+        $(this).addClass('hover');
+    },
+    function () {
+        $(this).removeClass('hover');
+    });
+});
