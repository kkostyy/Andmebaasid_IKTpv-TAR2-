diff --git a/Kujundus1/jaljeriba.css b/Kujundus1/jaljeriba.css
new file mode 100644
index 0000000..512a81e
--- /dev/null
+++ b/Kujundus1/jaljeriba.css
@@ -0,0 +1,130 @@
+/************ JÄLJERIBA (Breadcrumb) menüü *****************/
+/* Kast, milles jäljeriba asub – sobib lehe rohelise kujundusega */
+.jaljeriba {
+    font-family: Verdana, sans-serif;
+    font-variant: small-caps;
+    font-size: 15px;
+    text-align: left;
+    background-color: #e8f5e9;
+    border-left: 6px solid green;
+    border-bottom: 2px solid darkgreen;
+    border-radius: 4px;
+    margin: 5px;
+    padding: 8px 14px;
+}
+
+/* Klassid, mida jQuery lisab addClass() meetodiga */
+.ul_kujundus {
+    list-style: none;
+    margin: 0;
+    padding: 0;
+    display: inline;
+}
+.li_kujundus {
+    display: inline;
+}
+/* eraldaja iga alamtaseme ees (› nool) */
+.li_kujundus::before {
+    content: "\203A";
+    color: darkgreen;
+    font-weight: bold;
+    margin: 0 8px;
+}
+.jaljeriba li {
+    display: inline;
+}
+
+/* lingid */
+.jaljeriba a {
+    color: darkgreen;
+    text-decoration: none;
+    padding: 2px 6px;
+    border-radius: 4px;
+    transition: background-color 0.2s, color 0.2s;
+}
+/* jQuery hover() lisab selle klassi */
+.jaljeriba a.hover {
+    background-color: green;
+    color: white;
+}
+/* esimene lüli – Kodu */
+.jaljeriba .esimene > a::before {
+    content: "\2302  ";
+}
+/* praegune leht – viimane lüli, ei ole link */
+.jaljeriba .praegune > span {
+    color: black;
+    font-weight: bold;
+    padding: 2px 6px;
+}
+
+/************ Rippmenüü "Tehtud tööd" lülil *****************/
+.ripp-ymbris {
+    position: relative;
+    display: inline-block;
+}
+.ripp-nupp {
+    background: green;
+    color: white;
+    border: 1px solid darkgreen;
+    border-radius: 4px;
+    margin-left: 4px;
+    padding: 0 6px;
+    font-size: 13px;
+    line-height: 18px;
+    cursor: pointer;
+    transition: transform 0.25s;
+}
+.ripp-nupp:hover {
+    background: darkgreen;
+}
+.ripp-nupp.avatud {
+    transform: rotate(180deg);
+}
+.jaljeriba .rippmenyy {
+    position: absolute;
+    top: 100%;
+    left: 0;
+    z-index: 1000;
+    min-width: 280px;
+    margin: 6px 0 0;
+    padding: 4px 0;
+    list-style: none;
+    background: #ffffff;
+    border: 2px solid darkgreen;
+    border-top: 5px solid green;
+    border-radius: 4px;
+    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
+    text-align: left;
+}
+.jaljeriba .rippmenyy li {
+    display: block;
+}
+.jaljeriba .rippmenyy a {
+    display: block;
+    padding: 6px 12px;
+    border-radius: 0;
+    white-space: nowrap;
+}
+.jaljeriba .rippmenyy a.aktiivne {
+    font-weight: bold;
+    border-left: 4px solid green;
+    background: #e8f5e9;
+}
+
+/************ Vihjemull (tooltip) jäljeribal *****************/
+#vihje {
+    position: absolute;
+    z-index: 2000;
+    max-width: 260px;
+    padding: 8px 12px;
+    background-color: darkgreen;
+    color: #ffffff;
+    border: 2px solid #a5d6a7;
+    border-radius: 6px;
+    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
+    font-family: Verdana, sans-serif;
+    font-size: 13px;
+    line-height: 1.4;
+    pointer-events: none;   /* ei sega hiirt */
+}
